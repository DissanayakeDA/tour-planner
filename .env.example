# Copy this file to .env for local development. On Vercel, add the same variables in
# Project -> Settings -> Environment Variables (never commit .env).

# --- Neon Postgres (use the POOLED connection string: host contains "-pooler") ---
# DATABASE_URL is preferred; DATA_BASE_URL and POSTGRES_URL are also accepted.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Cloudinary (console -> Settings -> API Keys) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# ...or instead of the three above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Optional ---
# Folder for receipts in Cloudinary (default: trip-manager)
# CLOUDINARY_FOLDER=trip-manager
# Shared group PIN. Strongly recommended for a public vercel.app URL.
# APP_PIN=4821
# Local port for npm run dev (default: 3000)
# PORT=3000
